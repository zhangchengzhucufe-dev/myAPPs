/* ---- 更多：统计 / 词库 / 设置 / 同步 ---- */
function wordRows(){
  const k = wordFilter.trim().toLowerCase();
  const list = state.words.filter(w => !k || w.en.toLowerCase().includes(k) || w.zh.toLowerCase().includes(k));
  const shown = list.slice(0, 300);
  const rows = shown.map(w => {
    const st = w.reviewDone.filter(Boolean).length;
    const tag = !w.learnedAt ? '<span class="tag">未学</span>' : `<span class="tag ok">已学 · 复习 ${st}/3</span>`;
    const starMark = w.star ? '<span class="tag" style="color:var(--accent)">★</span>' : '';
    return `<div class="wrow"><span class="wen">${esc(w.en)}</span><span class="wzh">${esc(w.zh)}</span>${tag}${starMark}
      <button class="icon" data-action="word-del" data-id="${w.id}" title="删除">🗑</button></div>`;
  }).join('');
  return (rows || '<p class="muted">没有匹配的单词</p>') +
    (list.length > 300 ? `<p class="muted" style="margin-top:8px">仅显示前 300 个，共 ${list.length} 个匹配。</p>` : '');
}
function calcStreak(){
  let n = 0; const d = new Date();
  for(;;){ const v = state.daily[fmtDate(d)];
    if(v && (v.newGroups > 0 || v.reviewGroups > 0)){ n++; d.setDate(d.getDate() - 1); } else break;
  }
  return n;
}
function chart7(){
  const days = [];
  for(let i = 6; i >= 0; i--){ const dt = new Date(); dt.setDate(dt.getDate() - i); days.push(fmtDate(dt)); }
  const vals = days.map(k => { const v = state.daily[k]; return [v ? v.newWords : 0, v ? v.reviewWords : 0]; });
  const max = Math.max(10, ...vals.flat());
  return `<div class="chart">${days.map((k, i) => {
    const h1 = Math.round(vals[i][0] / max * 100), h2 = Math.round(vals[i][1] / max * 100);
    return `<div class="col"><div class="bars">
      <i class="b1" style="height:${h1}%" title="新学 ${vals[i][0]} 词"></i>
      <i class="b2" style="height:${h2}%" title="复习 ${vals[i][1]} 词"></i>
    </div><div class="dl">${k.slice(5)}</div></div>`;
  }).join('')}</div>
  <div class="legend"><span><i style="background:var(--accent)"></i>新学（词）</span><span><i style="background:var(--ok)"></i>复习（词）</span></div>`;
}
function forecast(){
  const rows = [];
  for(let i = 1; i <= 7; i++){
    const dt = new Date(); dt.setDate(dt.getDate() + i); const k = fmtDate(dt);
    const n = state.words.filter(w => {
      if(!w.learnedAt) return false;
      const d = diffDays(k, w.learnedAt);
      return w.reviewDone.some((done, j) => !done && d === OFFSETS[j]);
    }).length;
    rows.push(`<div class="frow row between"><span>${k === todayStr() ? '今天' : k}</span><span class="muted">${n} 个新到期</span></div>`);
  }
  return rows.join('') || '<p class="muted">暂无</p>';
}
