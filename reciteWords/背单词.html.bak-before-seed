    <div class="row between wrap gap8" style="margin-top:12px">
      <span class="muted">共 ${state.words.length} 个单词</span>
      <button class="btn ghost" data-action="sample">载入示例词库（40 词）</button>
    </div>
  </div>
  <div class="card"><h2>⚙️ 考试与外观</h2>
    <form id="examForm">
      <label>考试日期（设置后自动规划每日新学量）</label>
      <div class="row gap8">
        <input type="date" name="date" value="${state.settings.examDate || ''}" style="flex:1">
        <button class="btn" type="submit">保存</button>
        <button class="btn ghost" type="button" data-action="exam-clear">清除</button>
      </div>
    </form>
    <p class="muted" style="margin-top:8px">${p.daysLeft == null ? '尚未设置考试日期。'
      : p.expired ? '该日期已过期，请修改。'
      : `距考试 ${p.daysLeft} 天 · 建议每日新学 ${p.dailyNew} 词（${p.groups} 组），按 10 词一组统计进度。`}</p>
    <label style="margin-top:14px">外观模式</label>
    <div class="seg">
      ${[['auto','跟随系统'],['light','浅色'],['dark','夜间']].map(([v, l]) =>
