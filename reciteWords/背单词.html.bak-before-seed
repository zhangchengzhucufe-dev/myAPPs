      <li><b>每日计划</b>：设置考试日期后，每日新学量 = 剩余待学词数 ÷ 剩余天数（向上取整），进度按组（10 词）统计。</li>
      <li><b>导入</b>：英文重复时提示已存储并显示原释义，可选择补充或修改释义。</li>
      <li><b>手机端</b>：把本 HTML 文件通过数据线拷贝到手机，用浏览器打开即可；界面自动适配手机屏幕，支持夜间模式。</li>
    </ul>
  </div>
  <div class="card"><h2>🧹 维护</h2>
    <button class="btn ghost" data-action="wipe" style="color:var(--danger);border-color:var(--danger)">清空全部数据</button>
  </div>
  <p class="muted" style="text-align:center;margin:6px 0 10px">背单词 · v1 · 数据仅保存在本设备浏览器中</p>`;
}

/* ================= 弹窗 / 提示 ================= */
function showModal(html){ $('#modal .box').innerHTML = html; $('#modal').classList.remove('hidden'); }
function closeModal(){ $('#modal').classList.add('hidden'); }
let toastTimer;
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
}

/* ================= 同步 / 维护 ================= */
function exportData(){
  const blob = new Blob([JSON.stringify(state, null, 2)], { type:'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `背单词备份-${todayStr()}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 3000);
  toast('备份文件已导出，可用数据线复制到另一台设备再导入');
}
function handleImportFile(file){
  const r = new FileReader();
  r.onload = () => {
    try{
      const s = JSON.parse(r.result);
      if(!s || !Array.isArray(s.words)) throw new Error('bad');
      pendingImport = normalize(s);
      showModal(`<h3>确认导入备份？</h3>
        <p>备份中共 <b>${pendingImport.words.length}</b> 个单词。<b>导入将覆盖本设备当前的全部数据</b>（词库、进度、每日记录、设置）。</p>
        <div class="btnrow">
          <button class="btn ghost" data-action="modal-close">取消</button>
          <button class="btn ok" data-action="import-yes">确认导入</button>
        </div>`);
    }catch(e){ toast('文件格式不正确，导入失败'); }
  };
  r.readAsText(file);
}

/* ================= 事件 ================= */
document.addEventListener('click', e => {
  const el = e.target.closest('[data-action]');
  if(!el) return;
  const a = el.dataset.action;
  switch(a){
    case 'nav': go(el.dataset.view); break;
    case 'theme-btn':
      state.settings.theme = effectiveDark() ? 'light' : 'dark';
      applyTheme(); save(); render();
      toast(state.settings.theme === 'dark' ? '已切换到夜间模式 🌙' : '已切换到浅色模式 ☀️');
      break;
    case 'theme-set':
      state.settings.theme = el.dataset.v; applyTheme(); save(); render(); break;
    case 'start-study': startStudy(); break;
    case 'start-review': startReview(el.dataset.star === '1'); break;
    case 'start-restudy': startRestudy(el.dataset.star === '1'); break;
    case 'star': {
      if(!session) break;
      const w = state.words.find(v => v.id === session.words[session.idx].id);
      if(w){
        w.star = !w.star; save(); render();
        toast(w.star ? `已标记「${w.en}」为重点单词 ★` : `已取消「${w.en}」的重点标记`);
      }
      break;
    }
    case 'prev': moveSession(-1); break;
    case 'next': moveSession(1); break;
    case 'reveal': toggleReveal(); break;
    case 'restart': restartSession(); break;
    case 'finish': finishSession(); break;
    case 'quit':
      showModal(`<h3>退出${session ? (session.mode === 'study' ? '背诵' : session.mode === 'review' ? '复习' : '重背') : '本次学习'}？</h3>
        <p class="muted">本组进度不会保存，单词状态不变。</p>
        <div class="btnrow">
          <button class="btn ghost" data-action="modal-close">继续学习</button>
          <button class="btn" data-action="quit-yes">确认退出</button>
        </div>`);
      break;
    case 'quit-yes': session = null; closeModal(); render(); break;
    case 'modal-close': closeModal(); break;
    case 'dup-edit': {
      const w = state.words.find(x => x.id === el.dataset.id);
      if(w) openEditModal(w);
      break;
    }
    case 'dup-save': {
      const w = state.words.find(x => x.id === editingId);
      if(w){ w.zh = $('#dupZh').value.trim(); save(); closeModal(); render(); toast('释义已更新'); }
      break;
    }
    case 'exam-clear': state.settings.examDate = null; save(); render(); toast('已清除考试日期'); break;
    case 'export': exportData(); break;
    case 'import-file': $('#importFile').click(); break;
    case 'import-yes':
      if(pendingImport){ state = pendingImport; pendingImport = null; applyTheme(); save(); session = null; closeModal(); go('home'); toast('导入成功'); }
      break;
    case 'sample':
      showModal(`<h3>载入示例词库？</h3><p>将添加 ${SAMPLE.length} 个常用单词（英文重复的自动跳过）。</p>
        <div class="btnrow">
          <button class="btn ghost" data-action="modal-close">取消</button>
          <button class="btn" data-action="sample-yes">载入</button>
        </div>`);
      break;
    case 'sample-yes': {
      let n = 0;
      SAMPLE.forEach(([en, zh]) => { if(!findWord(en)){ addWord(en, zh); n++; } });
      save(); closeModal(); render(); toast(`已载入 ${n} 个示例单词`);
      break;
    }
    case 'wipe':
      showModal(`<h3>清空全部数据？</h3><p class="muted">将删除所有单词、学习进度和设置，且无法恢复。建议先导出备份。</p>
        <div class="btnrow">
          <button class="btn ghost" data-action="modal-close">取消</button>
          <button class="btn" data-action="wipe-yes" style="background:var(--danger);color:#fff">确认清空</button>
        </div>`);
      break;
    case 'wipe-yes':
      state = defaultState(); session = null; applyTheme(); save(); closeModal(); go('home'); toast('已清空全部数据');
      break;
    case 'word-del': {
      const w = state.words.find(x => x.id === el.dataset.id);
      if(!w) break;
      pendingDelId = w.id;
      showModal(`<h3>删除「${esc(w.en)}」？</h3><p class="muted">其学习与复习记录将一并删除。</p>
        <div class="btnrow">
          <button class="btn ghost" data-action="modal-close">取消</button>
          <button class="btn" data-action="del-yes" style="background:var(--danger);color:#fff">删除</button>
        </div>`);
      break;
    }
    case 'del-yes':
      state.words = state.words.filter(w => w.id !== pendingDelId);
      pendingDelId = null; save(); closeModal(); render(); toast('已删除');
      break;
  }
});
document.addEventListener('submit', e => {
  const f = e.target; e.preventDefault();
  if(f.id === 'importForm') onImportForm(f);
  else if(f.id === 'batchForm') onBatchForm(f);
  else if(f.id === 'examForm'){
    const v = f.date.value;
    if(!v){ toast('请选择考试日期'); return; }
    state.settings.examDate = v; save(); render();
    const p = plan();
    toast(`已设置：距考试 ${p.daysLeft > 0 ? p.daysLeft : 0} 天，建议每日新学 ${p.dailyNew} 词`);
  }
});
document.addEventListener('input', e => {
  if(e.target.id === 'wordSearch'){
    wordFilter = e.target.value;
    const body = $('#wordListBody'); if(body) body.innerHTML = wordRows();
  }
});
document.addEventListener('change', e => {
  if(e.target.id === 'importFile' && e.target.files[0]) handleImportFile(e.target.files[0]);
});
document.addEventListener('keydown', e => {
  if(!$('#modal').classList.contains('hidden')) return;
  const tag = document.activeElement && document.activeElement.tagName;
  if(tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
  const inSession = session && currentView === (session.mode === 'review' ? 'review' : 'study');
  if(!inSession) return;
  if(e.key === 'ArrowRight') moveSession(1);
  else if(e.key === 'ArrowLeft') moveSession(-1);
  else if(e.key === ' ' || e.code === 'Space'){ e.preventDefault(); toggleReveal(); }
});
if(window.matchMedia) matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', () => render());

/* ================= 启动 ================= */
applyTheme();
render();
</script>
</body>
</html>
