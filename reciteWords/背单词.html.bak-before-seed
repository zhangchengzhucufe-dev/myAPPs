<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f7f0dd">
<title>背单词</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%96%3C/text%3E%3C/svg%3E">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f7f0dd; --card:#fffdf6; --card2:#fbf5e4; --ink:#43372a; --muted:#9a8b6d;
  --line:#e7dab6; --accent:#b3812f; --accent-ink:#fff; --accent-soft:#f2e6c2;
  --ok:#6b9353; --danger:#c0603f; --shadow:0 2px 12px rgba(140,110,50,.10); --radius:16px;
}
[data-theme="dark"]{
  --bg:#141210; --card:#211d17; --card2:#2a251d; --ink:#f0e8d6; --muted:#a2947c;
  --line:#3c352a; --accent:#d5a44e; --accent-ink:#221a0c; --accent-soft:#37301f;
  --ok:#8fb377; --danger:#d98a6d; --shadow:0 2px 12px rgba(0,0,0,.45);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]):not([data-theme="dark"]){
    --bg:#141210; --card:#211d17; --card2:#2a251d; --ink:#f0e8d6; --muted:#a2947c;
    --line:#3c352a; --accent:#d5a44e; --accent-ink:#221a0c; --accent-soft:#37301f;
    --ok:#8fb377; --danger:#d98a6d; --shadow:0 2px 12px rgba(0,0,0,.45);
  }
}
html,body{height:100%}
body{font-family:"PingFang SC","Microsoft YaHei","Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.55;-webkit-tap-highlight-color:transparent}
#app{max-width:900px;margin:0 auto;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}
header{display:flex;align-items:center;justify-content:space-between;padding:14px 18px 6px}
header h1{font-size:22px;letter-spacing:1px}
#themeBtn{width:42px;height:42px;border-radius:12px;border:1.5px solid var(--line);background:var(--card);font-size:19px;cursor:pointer;color:var(--ink)}
#nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:var(--card);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom));z-index:20}
#nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;background:none;border:none;color:var(--muted);font-size:12px;padding:4px 0;cursor:pointer;position:relative;font-family:inherit}
#nav button .ic{font-size:20px;line-height:1.2}
#nav button.on{color:var(--accent);font-weight:600}
#nav .badge{position:absolute;top:0;right:calc(50% - 26px);background:var(--danger);color:#fff;font-size:10px;min-width:16px;height:16px;border-radius:8px;line-height:16px;padding:0 4px;font-style:normal;text-align:center}
main{flex:1;padding:10px 16px calc(96px + env(safe-area-inset-bottom))}
@media(min-width:760px){
  #nav{position:static;border-top:none;background:transparent;padding:4px 16px 0;justify-content:flex-start;gap:4px}
  #nav button{flex:none;flex-direction:row;gap:6px;font-size:15px;padding:8px 14px;border-radius:10px}
  #nav button.on{background:var(--accent-soft)}
  #nav .badge{position:static;margin-left:2px}
  main{padding:16px 16px 48px}
  #toast{bottom:28px}
}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;margin-bottom:14px}
.card h2{font-size:17px;margin-bottom:10px}
.muted{color:var(--muted);font-size:13.5px}
.row{display:flex;align-items:center}.between{justify-content:space-between}.gap8{gap:8px}
.btn{appearance:none;border:none;background:var(--accent);color:var(--accent-ink);font-size:15.5px;padding:10px 18px;border-radius:12px;cursor:pointer;font-weight:600;font-family:inherit}
.btn:hover{filter:brightness(1.06)}.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink);font-weight:500}
.btn.ok{background:var(--ok);color:#fff}
.btn.big{width:100%;padding:14px;font-size:17px}
.btnrow{display:flex;gap:10px;justify-content:flex-end;margin-top:14px;flex-wrap:wrap}
input,textarea,select{width:100%;background:var(--card2);border:1.5px solid var(--line);border-radius:12px;padding:11px 12px;font-size:16px;color:var(--ink);font-family:inherit}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--accent)}
form label{display:block;font-size:13px;color:var(--muted);margin:10px 0 5px}
.bar{height:10px;background:var(--accent-soft);border-radius:5px;overflow:hidden;margin:8px 0}
.bar i{display:block;height:100%;background:var(--accent);border-radius:5px;transition:width .3s}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:10px;margin-bottom:14px}
.tile{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 8px;text-align:center}
.tile b{display:block;font-size:22px;color:var(--accent)}
.tile span{font-size:12.5px;color:var(--muted)}
.wordcard{background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);min-height:280px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:30px 20px;text-align:center;cursor:pointer;user-select:none;-webkit-user-select:none;margin:12px 0}
.wordcard .en{font-size:42px;font-weight:700;letter-spacing:.5px;word-break:break-word}
.wordcard .zh{font-size:20px;background:var(--accent-soft);padding:10px 18px;border-radius:12px;max-width:100%;word-break:break-word}
.wordcard .hint{color:var(--muted);font-size:14.5px;border:1.5px dashed var(--line);padding:8px 16px;border-radius:999px}
.dots{display:flex;gap:7px;justify-content:center;margin:14px 0;flex-wrap:wrap}
.dots i{width:9px;height:9px;border-radius:50%;background:var(--accent-soft);border:1px solid var(--line)}
.dots i.v{background:var(--accent);border-color:var(--accent)}
.navrow{display:flex;gap:12px;margin-top:6px}
.navrow .btn{flex:1}
.starbtn.on{color:var(--accent);border-color:var(--accent);background:var(--accent-soft);font-weight:600}
.kbd-hint{display:none;text-align:center;color:var(--muted);font-size:13px;margin-top:12px}
.kbd-hint kbd{background:var(--card2);border:1px solid var(--line);border-bottom-width:2px;border-radius:6px;padding:1px 7px;font-size:12px;margin:0 2px;font-family:inherit}
@media (hover:hover) and (pointer:fine){.kbd-hint{display:block}}
.fin{display:flex;gap:12px;margin-top:12px}.fin .btn{flex:1}
.count b{font-size:46px;color:var(--accent);margin-right:6px}
.tag{font-size:11.5px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--muted);white-space:nowrap}
.tag.ok{color:var(--ok)}
.wrow{display:flex;align-items:center;gap:10px;padding:9px 4px;border-bottom:1px solid var(--line)}
.wrow .wen{font-weight:600;min-width:0;max-width:42%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wrow .wzh{flex:1;color:var(--muted);font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.icon{background:none;border:none;cursor:pointer;font-size:16px;opacity:.55}.icon:hover{opacity:1}
.chart{display:flex;align-items:flex-end;gap:10px;height:130px;padding:6px 2px 0}
.chart .col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.chart .bars{display:flex;gap:3px;align-items:flex-end;height:100%}
.chart .bars i{width:11px;border-radius:4px 4px 0 0;min-height:2px}
.chart .b1{background:var(--accent)}.chart .b2{background:var(--ok)}
.chart .dl{font-size:11px;color:var(--muted)}
.legend{display:flex;gap:14px;font-size:12.5px;color:var(--muted);margin-top:8px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px;vertical-align:-1px}
.frow{padding:7px 2px;border-bottom:1px solid var(--line);font-size:14.5px}
#toast{position:fixed;left:50%;bottom:calc(92px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(10px);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:12px;font-size:14.5px;opacity:0;pointer-events:none;transition:.25s;z-index:60;max-width:86vw;text-align:center;box-shadow:0 4px 18px rgba(0,0,0,.25)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#modal{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:20px}
#modal.hidden{display:none}
#modal .mask{position:absolute;inset:0;background:rgba(0,0,0,.45)}
#modal .box{position:relative;background:var(--card);border-radius:16px;padding:22px;max-width:440px;width:100%;box-shadow:0 10px 40px rgba(0,0,0,.25);max-height:86vh;overflow:auto}
#modal h3{margin-bottom:10px}
.dupzh{background:var(--card2);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin:8px 0 12px;word-break:break-word}
.seg{display:flex;gap:8px}
.seg button{flex:1;padding:9px;border-radius:10px;border:1.5px solid var(--line);background:transparent;color:var(--ink);cursor:pointer;font-size:14px;font-family:inherit}
.seg button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
ul.help{padding-left:20px;display:grid;gap:6px;font-size:14px}
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>📖 背单词</h1>
    <button id="themeBtn" data-action="theme-btn" title="切换浅色 / 夜间模式">🌗</button>
  </header>
  <nav id="nav"></nav>
  <main id="main"></main>
</div>
<div id="toast"></div>
<div id="modal" class="hidden"><div class="mask" data-action="modal-close"></div><div class="box"></div></div>
<script>
'use strict';
/* ================= 工具 ================= */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad = n => String(n).padStart(2, '0');
const fmtDate = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const todayStr = () => fmtDate(new Date());
function diffDays(a, b){ // a - b，按日历天
  const [ay,am,ad] = a.split('-').map(Number), [by,bm,bd] = b.split('-').map(Number);
  return Math.round((Date.UTC(ay, am-1, ad) - Date.UTC(by, bm-1, bd)) / 864e5);
}
function shuffle(a){ a = a.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }
const uid = () => (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : 'w' + Date.now() + Math.random().toString(36).slice(2);

/* ================= 示例词库 ================= */
const SAMPLE = [
["abandon","v. 放弃；抛弃"],["ability","n. 能力；才能"],["absorb","v. 吸收；使专心"],["abstract","adj. 抽象的 n. 摘要"],
["academic","adj. 学术的；学业的"],["accelerate","v. 加速；促进"],["access","n. 通道；使用权 v. 访问"],["accompany","v. 陪伴；伴随"],
["accomplish","v. 完成；实现"],["account","n. 账户；描述 v. 解释"],["accurate","adj. 准确的；精确的"],["achieve","v. 达到；实现"],
["acquire","v. 获得；习得"],["adapt","v. 适应；改编"],["adequate","adj. 足够的；适当的"],["adjust","v. 调整；适应"],
["admire","v. 钦佩；欣赏"],["adopt","v. 采用；收养"],["advance","v./n. 前进；进步"],["advantage","n. 优势；有利条件"],
["advocate","v. 提倡 n. 拥护者"],["affect","v. 影响；感动"],["afford","v. 负担得起；提供"],["aggressive","adj. 好斗的；有进取心的"],
["allocate","v. 分配；拨给"],["alter","v. 改变；更改"],["alternative","n. 替代方案 adj. 可替代的"],["ambition","n. 雄心；抱负"],
["analyze","v. 分析"],["announce","v. 宣布；声明"],["annual","adj. 每年的 n. 年刊"],["anticipate","v. 预期；期望"],
["anxiety","n. 焦虑；担忧"],["apparent","adj. 明显的；表面的"],["appreciate","v. 感激；欣赏"],["approach","n. 方法 v. 接近"],
["appropriate","adj. 恰当的；合适的"],["arouse","v. 唤起；激发"],["articulate","adj. 口齿清晰的 v. 清楚表达"],["assess","v. 评估；评定"]
];

/* ================= 数据与存储 ================= */
const LS = 'beidan.v1';
const OFFSETS = [1, 3, 6]; // T+1 / T+3 / T+6
const Z = { newGroups:0, newWords:0, reviewGroups:0, reviewWords:0 };
let state = load();
let session = null;        // { mode:'study'|'review', words:[...], idx, revealed:Set }
let editingId = null, pendingDelId = null, pendingImport = null;
let wordFilter = '';

function defaultState(){ return { version:1, words:[], settings:{ examDate:null, theme:'auto' }, daily:{} }; }
function normalize(s){
  s.settings = Object.assign({ examDate:null, theme:'auto' }, s.settings || {});
  s.daily = s.daily || {};
  s.words = (s.words || []).map(w => ({
    id: w.id || uid(),
    en: String(w.en || ''), zh: String(w.zh || ''),
    createdAt: w.createdAt || todayStr(),
    learnedAt: w.learnedAt || null,
    star: !!w.star,
    reviewDone: (Array.isArray(w.reviewDone) && w.reviewDone.length === 3) ? w.reviewDone.slice(0,3).map(Boolean) : [false,false,false]
  }));
  return s;
}
function load(){
  try{ const s = JSON.parse(localStorage.getItem(LS)); if(s && Array.isArray(s.words)) return normalize(s); }catch(_){}
  return defaultState();
}
function save(){ try{ localStorage.setItem(LS, JSON.stringify(state)); }catch(e){ toast('保存失败：浏览器存储不可用'); } }
function day(t){ const k = t || todayStr(); return state.daily[k] || (state.daily[k] = { newGroups:0, newWords:0, reviewGroups:0, reviewWords:0 }); }

/* ================= 主题 ================= */
function applyTheme(){ document.documentElement.dataset.theme = state.settings.theme; }
function effectiveDark(){
  return state.settings.theme === 'dark' ||
    (state.settings.theme === 'auto' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches);
}

/* ================= 计划与复习推导 ================= */
const unlearnedWords = () => state.words.filter(w => !w.learnedAt);
function plan(){
  const un = unlearnedWords().length;
  const exam = state.settings.examDate;
  if(!exam) return { daysLeft:null, unlearned:un };
  const dl = diffDays(exam, todayStr());
  if(dl < 0) return { daysLeft:dl, unlearned:un, expired:true };
  if(dl === 0) return { daysLeft:0, unlearned:un, dailyNew:un, groups:Math.ceil(un/10) };
  const dn = Math.ceil(un / dl); // 剩余词数 ÷ 剩余天数，向上取整保证考完前学完
  return { daysLeft:dl, unlearned:un, dailyNew:dn, groups:Math.ceil(dn/10) };
}
function isDue(w, t){
  if(!w.learnedAt) return false;
  const d = diffDays(t || todayStr(), w.learnedAt);
  return w.reviewDone.some((done, i) => !done && d >= OFFSETS[i]);
}
const dueWords = (t) => state.words.filter(w => isDue(w, t));

/* ================= 背诵 / 复习会话 ================= */
function startStudy(){
  const pool = shuffle(unlearnedWords());
  if(!pool.length){ toast('词库中没有待学的新词，请先到「导入」添加'); return; }
  session = { mode:'study', words:pool.slice(0,10), idx:0, revealed:new Set() };
  go('study');
}
function startReview(starOnly){
  const pool = shuffle(dueWords().filter(w => !starOnly || w.star));
  if(!pool.length){ toast(starOnly ? '今天到期的单词里还没有重点单词' : '今天没有到期的复习单词 🎉'); return; }
  session = { mode:'review', starOnly:!!starOnly, words:pool.slice(0,10), idx:0, revealed:new Set() };
  go('review');
}
function startRestudy(starOnly){
  const pool = shuffle(state.words.filter(w => w.learnedAt === todayStr() && (!starOnly || w.star)));
  if(!pool.length){ toast(starOnly ? '今天背过的新词里还没有重点单词' : '今天还没有背过新词，先完成一组背诵吧'); return; }
  session = { mode:'restudy', starOnly:!!starOnly, words:pool, idx:0, revealed:new Set() };
  go('study');
}
function moveSession(d){ if(!session) return; session.idx = Math.max(0, Math.min(session.words.length-1, session.idx + d)); render(); }
function toggleReveal(){
  if(!session) return;
  session.revealed.has(session.idx) ? session.revealed.delete(session.idx) : session.revealed.add(session.idx);
  render();
}
function restartSession(){ if(!session) return; session.idx = 0; session.revealed.clear(); render(); }
function finishSession(){
  const t = todayStr(), n = session.words.length;
  if(session.mode === 'restudy'){
    session = null; save(); go('home');
    toast(`已重背今日 ${n} 个新词，加油！`);
    return;
  }
  if(session.mode === 'study'){
    session.words.forEach(w => {
      const x = state.words.find(v => v.id === w.id);
      if(x && !x.learnedAt){ x.learnedAt = t; x.reviewDone = [false,false,false]; }
    });
    const d = day(t); d.newGroups++; d.newWords += n;
    toast(`完成一组背诵，新学 ${n} 词！已进入 T+1 / T+3 / T+6 复习计划`);
  }else{
    session.words.forEach(w => {
      const x = state.words.find(v => v.id === w.id);
      if(!x || !x.learnedAt) return;
      const dd = diffDays(t, x.learnedAt);
      for(let i=0;i<3;i++) if(!x.reviewDone[i] && dd >= OFFSETS[i]) x.reviewDone[i] = true; // 已到期的阶段一次清掉，当天不再出现
    });
    const d = day(t); d.reviewGroups++; d.reviewWords += n;
    toast(`复习完成 ${n} 词，今天不会再出现它们了！`);
  }
  session = null; save(); go('home');
}

/* ================= 导入 ================= */
function addWord(en, zh){ state.words.push({ id:uid(), en, zh, createdAt:todayStr(), learnedAt:null, reviewDone:[false,false,false] }); }
function findWord(en){ const k = en.trim().toLowerCase(); return state.words.find(w => w.en.trim().toLowerCase() === k); }
function onImportForm(f){
  const en = f.en.value.trim(), zh = f.zh.value.trim();
  if(!en){ toast('请输入英文单词'); return; }
  const ex = findWord(en);
  if(ex){ // 重复：弹出已存储提示 + 是否补充释义
    showModal(`<h3>「${esc(ex.en)}」已经存储过了</h3>
      <p class="muted">当前存储的中文释义：</p>
      <div class="dupzh">${esc(ex.zh) || '<span class="muted">（空）</span>'}</div>
      <p>是否补充 / 修改它的中文意思？</p>
      <div class="btnrow">
        <button class="btn ghost" data-action="modal-close">取消</button>
        <button class="btn" data-action="dup-edit" data-id="${ex.id}">补充释义</button>
      </div>`);
    return;
  }
  addWord(en, zh); save(); render();
  toast(`已添加「${en}」${zh ? '' : '（释义为空，可之后补充）'}`);
}
function openEditModal(w){
  editingId = w.id;
  showModal(`<h3>补充 / 修改释义</h3>
    <p class="muted">单词：${esc(w.en)}</p>
    <textarea id="dupZh" rows="3" style="margin-top:8px" placeholder="输入中文释义">${esc(w.zh)}</textarea>
    <div class="btnrow">
      <button class="btn ghost" data-action="modal-close">取消</button>
      <button class="btn" data-action="dup-save">保存</button>
    </div>`);
}
function onBatchForm(f){
  const lines = f.batch.value.split(/\n+/);
  let add = 0, skip = 0;
  lines.forEach(l => {
    l = l.trim(); if(!l) return;
    const m = l.match(/^([^,，＝:=\t]+)(?:[,，＝:=\t](.*))?$/);
    const en = (m ? m[1] : l).trim(), zh = (m && m[2] ? m[2] : '').trim();
    if(!en) return;
    if(findWord(en)){ skip++; return; }
    addWord(en, zh); add++;
  });
  save(); render();
  toast(add ? `批量导入完成：新增 ${add} 个${skip ? `，跳过重复 ${skip} 个` : ''}` : '没有可导入的内容');
}

/* ================= 渲染 ================= */
const NAVS = [['home','今日','🏠'],['study','背诵','📝'],['review','复习','🔁'],['import','导入','➕'],['more','更多','📊']];
let currentView = 'home';

function renderNav(){
  const dueG = Math.ceil(dueWords().length / 10);
  $('#nav').innerHTML = NAVS.map(([v, label, icon]) =>
    `<button data-action="nav" data-view="${v}" class="${currentView === v ? 'on' : ''}">
       <span class="ic">${icon}</span><span>${label}</span>${v === 'review' && dueG > 0 ? `<i class="badge">${dueG}</i>` : ''}
     </button>`).join('');
}
function go(v){ currentView = v; render(); window.scrollTo(0, 0); }
function render(){
  renderNav();
  $('#main').innerHTML = ({ home:vHome, study:vStudyTab, review:vReviewTab, import:vImport, more:vMore })[currentView]();
  $('#themeBtn').textContent = state.settings.theme === 'auto' ? '🌗' : (effectiveDark() ? '☀️' : '🌙');
}

/* ---- 今日 ---- */
function vHome(){
  const t = todayStr(), p = plan(), d = state.daily[t] || Z;
  const due = dueWords().length, dueG = Math.ceil(due / 10);
  const learned = state.words.length - p.unlearned;
  const todayNew = state.words.filter(w => w.learnedAt === t);
  const streak = calcStreak();

  const examCard = p.daysLeft == null
    ? `<h2>📅 考试倒计时</h2>
       <p class="muted">还没设置考试日期。设置后按「剩余待学 ÷ 剩余天数」自动规划每日新学量。</p>
       <form id="examForm" class="row gap8" style="margin-top:10px">
         <input type="date" name="date" style="flex:1" required>
         <button class="btn" type="submit">设置</button>
       </form>`
    : p.expired
      ? `<h2>📅 考试倒计时</h2><p class="muted">考试日期（${esc(state.settings.examDate)}）已过，可到「更多」里修改。</p>`
      : `<h2>📅 距考试还有</h2>
         <div class="count"><b>${p.daysLeft}</b><span>天</span></div>
         <p class="muted">考试日期：${esc(state.settings.examDate)} · 今日应新学 <b>${p.dailyNew}</b> 词 ≈ ${p.groups} 组</p>
         <button class="btn ghost" data-action="nav" data-view="more" style="margin-top:10px">修改日期</button>`;

  const newPct = p.groups ? Math.min(100, d.newGroups / p.groups * 100) : (d.newGroups ? 100 : 0);
  const newCard = `<div class="row between"><h2>🆕 今日新学</h2><span class="muted">词库待学 ${p.unlearned} 词</span></div>
    ${p.daysLeft == null ? '<p class="muted">未设置考试日期，暂无每日目标，可自由背诵。</p>' : ''}
    <div class="row between" style="margin:8px 0 2px"><span>今日目标：${p.groups ? `${p.dailyNew} 词（${p.groups} 组）` : '自由背诵'}</span><b>${d.newGroups} 组已完成</b></div>
    <div class="bar"><i style="width:${newPct}%"></i></div>
    ${p.groups && d.newGroups >= p.groups ? '<p class="muted">🎉 已达成今日新学计划，可继续加练。</p>' : ''}
    ${p.unlearned
      ? `<button class="btn big" data-action="start-study" style="margin-top:10px">开始背诵（随机 10 词一组）</button>`
      : '<p class="muted" style="margin-top:10px">词库里的单词都已学完，去「导入」添加新词吧。</p>'}
    ${todayNew.length ? `<button class="btn big ghost" data-action="start-restudy" style="margin-top:10px">🔁 重背今日新词（${todayNew.length} 词）</button>` : ''}`;

  const revTotal = d.reviewGroups + dueG;
  const revPct = revTotal ? d.reviewGroups / revTotal * 100 : 0;
  const revCard = `<div class="row between"><h2>🔁 今日复习</h2><span class="muted">到期 ${due} 词</span></div>
    ${due === 0 && d.reviewGroups === 0
      ? '<p class="muted">今日没有到期的复习单词。<br>复习节奏：背完后的第 1、3、6 天各复习一次。</p>'
      : `<div class="row between" style="margin:8px 0 2px"><span>今日进度</span><b>${d.reviewGroups} 组已完成 · 剩余 ${dueG} 组</b></div>
         <div class="bar"><i style="width:${revPct}%"></i></div>`}
    ${due
      ? `<button class="btn big" data-action="start-review" style="margin-top:10px">开始复习（${dueG} 组）</button>`
      : (d.reviewGroups ? '<p class="muted" style="margin-top:10px">🎉 今日复习已全部完成！</p>' : '')}`;

  const tiles = `<div class="tiles">
    <div class="tile"><b>${state.words.length}</b><span>词库总数</span></div>
    <div class="tile"><b>${learned}</b><span>已学习</span></div>
    <div class="tile"><b>${d.newWords}</b><span>今日新学</span></div>
    <div class="tile"><b>${d.reviewWords}</b><span>今日复习</span></div>
    <div class="tile"><b>${due}</b><span>待复习</span></div>
    <div class="tile"><b>${streak}</b><span>连续天数</span></div>
  </div>`;

  return `<div class="card">${examCard}</div><div class="card">${newCard}</div><div class="card">${revCard}</div>${tiles}`;
}

/* ---- 背诵 / 复习标签页 ---- */
function vStudyTab(){
  if(session && (session.mode === 'study' || session.mode === 'restudy')) return vSession();
  const t = todayStr(), p = plan(), d = state.daily[t] || Z;
  const pool = unlearnedWords().length;
  const todayNew = state.words.filter(w => w.learnedAt === t);
  const todayStar = todayNew.filter(w => w.star).length;
  const pct = p.groups ? Math.min(100, d.newGroups / p.groups * 100) : (d.newGroups ? 100 : 0);
  return `<div class="card">
    <h2>📝 背诵新词</h2>
    ${p.daysLeft == null ? '<p class="muted">尚未设置考试日期，设置后可自动规划每日新学量（仍可自由背诵）。</p>' : ''}
    <div class="row between" style="margin:10px 0 2px"><span>今日新学进度</span><b>${p.groups ? `${d.newGroups} / ${p.groups} 组` : `${d.newGroups} 组`}</b></div>
    <div class="bar"><i style="width:${pct}%"></i></div>
    <div class="muted">今日已新学 ${d.newWords} 词 · 词库剩余待学 ${pool} 词</div>
    ${p.groups && d.newGroups >= p.groups ? '<p class="muted" style="margin-top:8px">🎉 已达成今日背诵计划，可继续加练。</p>' : ''}
    ${pool ? '<button class="btn big" data-action="start-study" style="margin-top:14px">开始一组（10 词随机抽取）</button>'
           : '<p class="muted" style="margin-top:12px">词库中没有待学新词，请先到「导入」添加。</p>'}
    ${todayNew.length ? `<button class="btn big ghost" data-action="start-restudy" style="margin-top:10px">🔁 重背今日新词（${todayNew.length} 词）</button>` : ''}
    ${todayStar ? `<button class="btn big ghost" data-action="start-restudy" data-star="1" style="margin-top:10px">⭐ 只重背今日重点（${todayStar} 词）</button>` : ''}
  </div>`;
}
function vReviewTab(){
  if(session && session.mode === 'review') return vSession();
  const t = todayStr(), d = state.daily[t] || Z;
  const due = dueWords().length, dueG = Math.ceil(due / 10);
  const dueStar = dueWords().filter(w => w.star).length;
  const doneAll = due === 0 && d.reviewGroups > 0;
  return `<div class="card">
    <h2>🔁 复习单词</h2>
    ${due === 0 && d.reviewGroups === 0
      ? '<p class="muted">今日没有到期需要复习的单词。<br>复习节奏：单词背完后的第 1、3、6 天各复习一次，到期会自动出现在这里。</p>'
      : `<div class="row between" style="margin:10px 0 2px"><span>今日复习进度</span><b>${d.reviewGroups} 组已完成 · 剩余 ${dueG} 组</b></div>
         <div class="muted">待复习 ${due} 词，随机顺序、每组 10 个。</div>`}
    ${doneAll ? '<p class="muted" style="margin-top:8px">🎉 今日复习已全部完成！</p>' : ''}
    ${due ? '<button class="btn big" data-action="start-review" style="margin-top:14px">开始复习一组</button>' : ''}
    ${dueStar ? `<button class="btn big ghost" data-action="start-review" data-star="1" style="margin-top:10px">⭐ 只复习重点单词（${dueStar} 词）</button>` : ''}
  </div>`;
}
function vSession(){
  const s = session, w = s.words[s.idx], last = s.idx === s.words.length - 1;
  const name = s.mode === 'study' ? '背诵新词' : s.mode === 'review' ? '复习单词' : '重背今日新词';
  return `<div class="row between" style="flex-wrap:wrap;gap:8px">
      <div class="row gap8"><span class="tag">${s.starOnly ? '⭐ ' : ''}${name}</span><span class="muted">第 ${s.idx + 1} / ${s.words.length} 个</span></div>
      <div class="row gap8">
        <button class="btn ghost starbtn ${w.star ? 'on' : ''}" data-action="star" style="padding:6px 14px">${w.star ? '★ 重点单词' : '☆ 标记重点'}</button>
        <button class="btn ghost" data-action="quit" style="padding:6px 14px">退出</button>
      </div>
    </div>
    <div class="wordcard" data-action="reveal" title="点击显示 / 隐藏中文">
      <div class="en">${esc(w.en)}</div>
      ${s.revealed.has(s.idx)
        ? `<div class="zh">${esc(w.zh) || '<span class="muted">（未填写中文释义）</span>'}</div>`
        : '<div class="hint">👆 点击查看中文意思</div>'}
    </div>
    <div class="dots">${s.words.map((_, i) => `<i class="${i <= s.idx ? 'v' : ''}"></i>`).join('')}</div>
    <div class="navrow">
      <button class="btn ghost" data-action="prev" ${s.idx === 0 ? 'disabled' : ''}>← 上一个</button>
      ${last ? '' : '<button class="btn" data-action="next">下一个 →</button>'}
    </div>
    ${last ? `<div class="fin">
        <button class="btn ghost" data-action="restart">↩ 返回重来</button>
        <button class="btn ok" data-action="finish">✓ ${s.mode === 'restudy' ? '完成重背' : `完成本组${s.mode === 'study' ? '背诵' : '复习'}`}</button>
      </div>
      <p class="muted" style="text-align:center;margin-top:10px">${s.mode === 'study'
        ? '点击完成后，这组单词标记为已学习，并自动进入 T+1 / T+3 / T+6 复习计划'
        : s.mode === 'review'
        ? '点击完成后，这些单词今天不再参与复习'
        : '重背只是把今天的新词再过一遍，不会重复计入学习进度'}</p>` : ''}
    <div class="kbd-hint">⌨️ <kbd>←</kbd><kbd>→</kbd> 切换单词 · <kbd>空格</kbd> 显示 / 隐藏释义</div>`;
}

